# --- App ---
APP_NAME=FarmWise AI
APP_ENV=development
API_V1_PREFIX=/api/v1

# --- Security / JWT ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production — the app now refuses to start without a strong one (core/auth.py).
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=90

# --- Supabase ---
# Project Settings -> API. Use the service_role key (bypasses RLS),
# NOT the anon key, for SUPABASE_KEY.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=

# --- AI Assistant (Google Gemini free tier — https://aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Email (Resend — free tier, no credit card, onboarding@resend.dev works pre-verification) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# --- SMS OTP (optional — phone-based reset falls back gracefully if unset) ---
SMS_PROVIDER_API_KEY=

# --- CORS ---
# Comma-separated, no spaces, no trailing slash.
# Required in production — the app now refuses to start without this set (main.py).
CORS_ORIGINS=https://your-frontend-domain.onrender.com

RATE_LIMIT_DEFAULT=60
